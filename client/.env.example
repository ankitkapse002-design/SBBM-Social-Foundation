# ==============================================================================
# Client Environment Configuration (Vite)
# ==============================================================================

# Base URL for backend API requests.
# - In local development: defaults to http://localhost:5000/api
# - In unified production (same origin): defaults to /api
# - In Netlify production (separate backend): set to your live backend API endpoint:
#   e.g., VITE_API_URL=https://api.sbbmsocialfoundation.org/api
VITE_API_URL=/api
