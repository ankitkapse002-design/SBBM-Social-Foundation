# ==============================================================================
# SBBM Social Foundation - Environment Configuration Guide
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Netlify Site Configuration -> Environment Variables)
# ------------------------------------------------------------------------------
# VITE_API_URL: The base URL for backend API calls.
# - If backend is deployed separately (e.g. Render, Railway, Fly.io, Linux VPS):
#   Set to your live API URL, e.g.: https://api.sbbmsocialfoundation.org/api
#   or https://ssbm-backend.onrender.com/api
# - If left empty, production builds default to relative '/api'
VITE_API_URL=https://api.sbbmsocialfoundation.org/api

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Render, Railway, VPS, or Docker container)
# ------------------------------------------------------------------------------
# Server port (provided automatically by hosting provider or defaults to 5000)
PORT=5000

# Environment mode
NODE_ENV=production

# Cryptographic JWT Secret (Generate a secure 64-character random string)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_for_production

# Frontend Origin for CORS (e.g., https://sbbmsocialfoundation.org or your Netlify site URL)
CLIENT_URL=https://sbbmsocialfoundation.org

